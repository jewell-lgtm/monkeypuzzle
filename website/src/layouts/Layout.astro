---
import '../styles/design-system.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Monkeypuzzle — solve big problems one piece at a time',
  description = 'A git workflow for the terminal: one piece of work, one worktree, one PR. mp stacks the pieces, opens the PRs, and cleans up after the merge.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Fonts (also @imported by the type tokens; preconnect speeds the fetch) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="mp-canvas">
    <slot />
  </body>
</html>
