---
---

<section class="min-h-screen flex flex-col items-center justify-center px-4 pt-16 bg-hero-gradient">
  <div class="text-center max-w-3xl mx-auto">
    <!-- Logo -->
    <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold tracking-tight mb-6">
      <span class="bg-gradient-to-r from-accent-pink via-accent-purple to-accent-teal bg-clip-text text-transparent">
        monkeypuzzle
      </span>
    </h1>

    <!-- Tagline -->
    <p class="text-xl sm:text-2xl text-muted mb-12">
      One workflow for humans and AI agents
    </p>

    <!-- Install Command -->
    <div class="mb-12">
      <div class="squircle inline-block p-1">
        <code class="block px-4 py-3 text-sm sm:text-base text-foreground font-mono">
          <span class="text-accent-pink">git clone</span> github.com/jewell-lgtm/monkeypuzzle && <span class="text-accent-pink">make install</span>
        </code>
      </div>
    </div>

    <!-- Terminal Preview -->
    <div class="max-w-2xl mx-auto">
      <div class="squircle squircle-lg overflow-hidden shadow-2xl">
        <!-- Terminal Header -->
        <div class="flex items-center gap-2 px-4 py-3 border-b border-bg-elevated bg-bg-card/50">
          <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
          <span class="ml-2 text-xs text-muted font-mono">terminal</span>
        </div>
        <!-- Terminal Content -->
        <div class="p-4 font-mono text-sm text-left space-y-2 bg-bg-card">
          <div>
            <span class="text-accent-pink">$</span>
            <span class="text-foreground"> mp piece create --issue issues/add-auth.md</span>
          </div>
          <div class="text-muted">
            <span class="text-status-green">✓</span> Created piece: add-auth
          </div>
          <div class="text-muted">
            <span class="text-status-green">✓</span> Worktree: ~/.local/share/monkeypuzzle/pieces/add-auth
          </div>
          <div class="text-muted">
            <span class="text-status-green">✓</span> Tmux session: mp-piece-add-auth
          </div>
          <div class="mt-4">
            <span class="text-accent-pink">$</span>
            <span class="text-foreground"> mp piece pr create</span>
          </div>
          <div class="text-muted">
            <span class="text-status-green">✓</span> Created PR #42
          </div>
        </div>
      </div>
    </div>

    <!-- Subtitle -->
    <p class="mt-12 text-muted text-sm">
      Git worktrees. No stashing. Pure flow.
    </p>
  </div>
</section>
