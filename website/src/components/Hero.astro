---
import TerminalBlock from './TerminalBlock.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';

// Single source of truth for the install command: data-cmd (what the copy
// button writes) and the displayed text both derive from INSTALL_CMD.
const INSTALL_CMD = 'brew install jewell-lgtm/tap/monkeypuzzle';
const [INSTALL_BIN, ...INSTALL_ARGS] = INSTALL_CMD.split(' ');
const INSTALL_REST = INSTALL_ARGS.join(' ');

// The piece loop, create → pr create → done. Output lines are copied from real
// `mp` runs on a terminal (pr create's from the strings in internal/core/pr).
const lines = [
  { cmd: 'create --name auth-schema' },
  { text: '✓ Created piece: auth-schema at ~/acme/.monkeypuzzle/pieces/auth-schema', tone: 'ok' },
  { text: '→ next: mp pr create --draft', tone: 'muted' },
  { text: '' },
  { cmd: 'pr create --draft' },
  { text: 'Pushing branch auth-schema to origin...', tone: 'muted' },
  { text: 'Creating PR...', tone: 'muted' },
  { text: '✓ Created PR #481: https://github.com/you/acme/pull/481', tone: 'ok' },
  { text: '' },
  { cmd: 'done' },
  { text: '✓ Done with piece: auth-schema', tone: 'ok' },
] as const;
---

<section class="hero">
  <div class="site">
    <span class="eyebrow"><Icon name="GitBranch" size={13} /> git workflow for the terminal</span>
    <h1>Solve big problems<br /> <span class="g">one piece at a time</span></h1>
    <p class="lede">
      One piece of work. One worktree. One PR. mp stacks the pieces, opens the
      PRs, and cleans up after the merge. Hooks fire at every step.
    </p>
    <div class="cta">
      <div class="install" id="install" data-cmd={INSTALL_CMD}>
        <span class="p">$</span>
        <span class="cmd"><span class="k">{INSTALL_BIN}</span> {INSTALL_REST}</span>
        <button type="button" aria-label="Copy install command">
          <Icon name="Copy" size={15} class="install__copy" />
          <Icon name="Check" size={15} class="install__check" />
        </button>
      </div>
      <Button size="lg" href="/workflow" iconTrailing="ArrowRight">See how it works</Button>
    </div>
    <div class="hero__demo">
      <TerminalBlock prompt="~/acme" cursor lines={lines} />
    </div>
  </div>
</section>

<script>
  const install = document.getElementById('install');
  const btn = install?.querySelector('button');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(install?.dataset.cmd ?? '');
    } catch {
      // Clipboard may be unavailable (insecure context); still show feedback.
    }
    install?.classList.add('copied');
    setTimeout(() => install?.classList.remove('copied'), 1400);
  });
</script>
