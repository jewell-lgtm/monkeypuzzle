---
// A workflow scene: a numbered step with copy on one side and a visual (passed
// via the `visual` named slot) on the other. Reveals on scroll. `flip` puts the
// visual on the left.
interface Props {
  n: number | string;
  eyebrow: string;
  title: string;
  flip?: boolean;
  id?: string;
  class?: string;
}

const { n, eyebrow, title, flip = false, id, class: cls = '' } = Astro.props;
---

<section class:list={['wf-scene', flip && 'wf-scene--flip', cls]} id={id} data-reveal>
  <div class="wf-scene__copy">
    <div class="wf-scene__kicker"><span class="wf-step">{n}</span><span class="wf-scene__eyebrow">{eyebrow}</span></div>
    <h2 class="wf-scene__title">{title}</h2>
    <div class="wf-scene__body"><slot /></div>
  </div>
  <div class="wf-scene__visual"><slot name="visual" /></div>
</section>
