---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { GITHUB_URL, DOCS_URL } from '../config';
---

<div class="site">
  <nav class="nav">
    <Logo size={24} href="/" />
    <div class="nav__links">
      <a href="/workflow">How it works</a>
      <a href="/#features">Features</a>
      <a href="/#editions">Pricing</a>
      <a href={DOCS_URL}>Docs</a>
    </div>
    <div class="nav__spacer"></div>
    <div class="nav__right">
      <Button size="sm" variant="secondary" icon="Github" href={GITHUB_URL}>Star</Button>
      <Button size="sm" variant="accent" href="/#get-started">Get started</Button>
    </div>
  </nav>
</div>
