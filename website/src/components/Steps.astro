---
const steps = [
  {
    n: 1,
    title: 'Cut',
    body: 'Start a piece: a new branch in its own worktree, one idea at a time.',
    cmds: ['mp create --name auth-schema'],
  },
  {
    n: 2,
    title: 'Stack',
    body: 'Build the next piece on top. Changed something below? Sync the tree in one go.',
    cmds: ['mp stack append auth-api', 'mp stack sync'],
  },
  {
    n: 3,
    title: 'Ship',
    body: 'Open a PR per piece, merge from the bottom up, and clear away the worktree.',
    cmds: ['mp pr create', 'mp merge', 'mp done'],
  },
];
---

<section class="section" style="padding-top:0">
  <div class="site">
    <div class="section__eyebrow">Three moves</div>
    <h2 class="section__title">Cut. Stack. Ship.</h2>
    <div class="steps">
      {
        steps.map((s) => (
          <div class="step">
            <span class="step__n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            {s.cmds.map((c) => <code>{c}</code>)}
          </div>
        ))
      }
    </div>
    <p class="fit">
      <span class="fit__h">Fits your setup</span>
      <span>your editor via <code>mp open</code></span>
      <span>your shell via <code>mp shell-init</code></span>
      <span>tmux or herdr</span>
      <span>coding agents</span>
      <a href="/docs/integrations/">Integrations →</a>
    </p>
  </div>
</section>
