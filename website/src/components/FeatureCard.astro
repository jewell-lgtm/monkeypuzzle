---
interface Props {
  title: string;
  description: string;
  icon: string;
}

const { title, description, icon } = Astro.props;
---

<div class="group squircle p-6 hover:bg-bg-elevated/60 transition-colors">
  <div class="text-3xl mb-4">{icon}</div>
  <h3 class="text-lg font-semibold text-foreground mb-2 group-hover:text-accent-pink transition-colors">
    {title}
  </h3>
  <p class="text-muted text-sm leading-relaxed">
    {description}
  </p>
</div>
