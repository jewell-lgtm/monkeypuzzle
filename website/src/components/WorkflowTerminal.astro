---
// A TerminalBlock that types its command lines and reveals output when it
// scrolls into view (driven by the workflow page's animation script). Command
// text is also rendered inline so it works with JS disabled / reduced motion.
import Logo from './Logo.astro';

interface Line {
  cmd?: string;
  out?: string;
  tone?: 'cmd' | 'muted' | 'ok' | 'warn' | 'err' | 'info';
}
interface Props {
  title?: string;
  prompt?: string;
  lines: Line[];
  rest?: boolean;
  class?: string;
}

const { title = 'monkeypuzzle', prompt = '~/acme', lines, rest = true, class: cls = '' } =
  Astro.props;

const TONE: Record<string, string> = {
  cmd: 'mp-term__cmd',
  muted: 'mp-term__muted',
  ok: 'mp-term__ok',
  warn: 'mp-term__warn',
  err: 'mp-term__err',
  info: 'mp-term__info',
};
---

<div class:list={['mp-term', 'wf-term', cls]} data-term-anim>
  <div class="mp-term__bar">
    <Logo variant="mark" size={16} class="mp-term__logo" />
    <span class="mp-term__title">{title}</span>
  </div>
  <div class="mp-term__body">{
    lines.map((ln) =>
      ln.cmd !== undefined ? (
        <span class="mp-term__line wf-line" data-kind="cmd" data-text={ln.cmd}><span class="mp-term__prompt">{prompt} <b>mp</b> </span><span class="mp-term__cmd">{ln.cmd}</span></span>
      ) : (
        <span class:list={['mp-term__line', 'wf-line', ln.tone && TONE[ln.tone]]} data-kind="out">{ln.out}</span>
      )
    )
  }{rest && <span class="mp-term__line wf-line wf-rest" data-kind="rest"><span class="mp-term__prompt">{prompt} <b>mp</b> </span><span class="mp-term__cursor"></span></span>}</div>
</div>
