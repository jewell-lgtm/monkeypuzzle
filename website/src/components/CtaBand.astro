---
import Badge from './Badge.astro';
import Button from './Button.astro';
import { GITHUB_URL, TURNSTILE_SITE_KEY } from '../config';
---

<section class="section" style="padding-top:0" id="get-started">
  <div class="site">
    <div class="band">
      <Badge tone="green" dot>the CLI is free &amp; open source</Badge>
      <h2 style="margin-top:16px">Your fleet's work, finally in order.</h2>
      <p>
        Start with the free CLI today — the install command is at the top of the
        page. Leave your email to follow what ships next.
      </p>
      <div class="band__actions">
        <!--
          Email capture posts to the `subscribe` Astro Action (src/actions).
          States: idle → loading (button disabled = double-click guard) →
          success (form swapped for confirmation) / error (inline, recoverable).
          The action returns outcomes as data, not exceptions.
        -->
        <form class="band__form" id="waitlist-form" novalidate>
          <input
            type="email"
            name="email"
            required
            maxlength="254"
            placeholder="you@yourco.dev"
            aria-label="Email address"
            autocomplete="email"
          />
          <!-- Honeypot: invisible to humans (CSS + tabindex + aria-hidden);
               bots that autofill it get a fake success and nothing is stored. -->
          <input
            class="band__hp"
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />
          <!-- Turnstile (implicit render): injects a hidden
               cf-turnstile-response input into this form's data.
               interaction-only = invisible unless Cloudflare wants a check. -->
          <div
            class="cf-turnstile"
            data-sitekey={TURNSTILE_SITE_KEY}
            data-appearance="interaction-only"
            data-size="flexible"
          ></div>
          <Button size="lg" variant="accent" type="submit" iconTrailing="ArrowRight">
            Follow what ships next
          </Button>
        </form>
        <Button size="lg" variant="secondary" icon="Github" href={GITHUB_URL}>Star on GitHub</Button>
      </div>
      <p class="band__form-msg" id="waitlist-msg" role="status" aria-live="polite"></p>
      <noscript>
        <p class="band__form-msg">
          JavaScript is off — star <a href={GITHUB_URL}>the repo</a> or watch releases to follow along instead.
        </p>
      </noscript>
    </div>
  </div>
</section>

<!-- Turnstile loader (implicit render finds .cf-turnstile). is:inline so
     Astro doesn't try to bundle a cross-origin script. -->
<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<style>
  .band__form {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
  }
  /* Honeypot: visually gone, still in the DOM for autofilling bots. Not
     display:none — some bots skip those. */
  .band__form input.band__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    min-width: 0;
    opacity: 0;
    pointer-events: none;
  }
  /* When Cloudflare escalates from invisible to an interactive check, give
     the widget its own centered row instead of squeezing the flex line. */
  .band__form .cf-turnstile {
    flex-basis: 100%;
    display: flex;
    justify-content: center;
  }
  .band__form input {
    font-family: var(--mp-font-mono, monospace);
    font-size: 14px;
    color: var(--mp-text-primary);
    background: var(--mp-bg-primary);
    border: 1px solid var(--mp-border-default);
    border-radius: var(--mp-radius-md, 8px);
    padding: 0 14px;
    min-width: 240px;
  }
  .band__form input:focus-visible {
    outline: none;
    box-shadow: var(--mp-glow-green);
    border-color: var(--mp-accent-primary, currentColor);
  }
  .band__form input[aria-invalid='true'] {
    border-color: var(--mp-status-error, #e5484d);
  }
  .band__form-msg {
    min-height: 1.4em;
    margin-top: 14px;
    font-family: var(--mp-font-mono, monospace);
    font-size: 13px;
  }
  .band__form-msg[data-tone='ok'] { color: var(--mp-status-ok, #46a758); }
  .band__form-msg[data-tone='err'] { color: var(--mp-status-error, #e5484d); }
</style>

<script>
  import { actions } from 'astro:actions';

  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const msg = document.getElementById('waitlist-msg');
  const input = form?.querySelector('input[name="email"]') as HTMLInputElement | null;
  const button = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  function show(tone: 'ok' | 'err', text: string) {
    if (!msg) return;
    msg.dataset.tone = tone;
    msg.textContent = text;
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!input || !button || button.disabled) return; // disabled = in flight (double-click guard)

    input.setAttribute('aria-invalid', 'false');
    const original = button.textContent;
    button.disabled = true;
    button.textContent = 'Sending…';

    try {
      const { data, error } = await actions.subscribe(new FormData(form));
      if (error || !data) {
        show('err', 'Something went wrong — please try again.');
      } else if (data.ok) {
        show('ok', data.message);
        form.reset();
        if (data.code === 'added') input.disabled = true;
      } else {
        show('err', data.message);
        if (data.code === 'invalid') input.setAttribute('aria-invalid', 'true');
      }
    } catch {
      show('err', 'Network hiccup — check your connection and try again.');
    } finally {
      button.disabled = false;
      button.textContent = original;
      // Turnstile tokens are single-use: re-arm the widget after every
      // attempt so a retry (bot_check, network hiccup) gets a fresh token.
      (window as { turnstile?: { reset?: () => void } }).turnstile?.reset?.();
    }
  });
</script>
