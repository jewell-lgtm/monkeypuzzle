---
import Logo from './Logo.astro';
import { LOGIN_URL, GITHUB_URL, DOCS_URL } from '../config';
---

<div class="site">
  <footer class="footer">
    <div>
      <Logo size={20} />
      <p class="footer__copy">© 2026 Monkeypuzzle · made for people who live in the shell</p>
    </div>
    <div class="footer__cols">
      <div class="footer__col">
        <h2 class="h">Product</h2>
        <a href="#features">Features</a>
        <a href={LOGIN_URL}>Download</a>
        <a href={`${GITHUB_URL}/releases`}>Changelog</a>
      </div>
      <div class="footer__col">
        <h2 class="h">Develop</h2>
        <a href={DOCS_URL}>Docs</a>
        <a href={`${GITHUB_URL}/tree/main/docs`}>CLI reference</a>
        <a href={GITHUB_URL}>GitHub</a>
      </div>
      <div class="footer__col">
        <h2 class="h">Company</h2>
        <a href={`${GITHUB_URL}/blob/main/README.md`}>About</a>
        <a href={`${GITHUB_URL}/issues`}>Issues</a>
        <a href={`${GITHUB_URL}/discussions`}>Contact</a>
      </div>
    </div>
  </footer>
</div>
