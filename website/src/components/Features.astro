---
import Card from './Card.astro';
import Icon from './Icon.astro';

const features = [
  {
    icon: 'Layers',
    title: 'Stacks, not mega-PRs',
    body: 'Break a feature into a chain of small pieces. Each reviews in minutes; the stack ships as one.',
  },
  {
    icon: 'RefreshCw',
    title: 'Restack on autopilot',
    body: 'Change a piece low in the stack and Monkeypuzzle rebases everything above it — conflicts surfaced, never silent.',
  },
  {
    icon: 'GitPullRequest',
    title: 'One command to submit',
    bodyHtml:
      '<code class="feature__cmd">mp pr create</code> opens or updates a PR per piece, wired parent-to-parent, with the stack drawn in each description.',
  },
  {
    icon: 'GitPullRequest',
    title: 'Native to GitHub & GitLab',
    body: 'First-class on both forges — pull requests or merge requests, with the checks and reviews you already have. No new forge, no lock-in.',
  },
  {
    icon: 'Zap',
    title: 'Built for the terminal',
    body: 'A fast, friendly CLI first — plus a web dashboard when you want the whole team\'s stacks in one place.',
  },
  {
    icon: 'Eye',
    title: 'The stack, visualized',
    body: 'Every piece, its status, and its place in the tree — readable at a glance, in your shell or the dashboard.',
  },
];
---

<section class="section" id="features">
  <div class="site">
    <div class="section__eyebrow">Why stacks</div>
    <h2 class="section__title">Big features, small reviews.</h2>
    <div class="features">
      {
        features.map((f) => (
          <Card pad interactive>
            <div class="feature">
              <div class="feature__ico"><Icon name={f.icon} size={20} /></div>
              <h3>{f.title}</h3>
              {f.bodyHtml ? <p set:html={f.bodyHtml} /> : <p>{f.body}</p>}
            </div>
          </Card>
        ))
      }
    </div>
  </div>
</section>
