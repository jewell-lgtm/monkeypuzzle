---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Scene from '../components/Scene.astro';
import WorkflowTerminal from '../components/WorkflowTerminal.astro';
import PieceStack from '../components/PieceStack.astro';
import Card from '../components/Card.astro';
import Badge from '../components/Badge.astro';
import Button from '../components/Button.astro';
import '../styles/workflow.css';

// Terminal output below is copied from real `mp` runs on a terminal (plain
// shell, no multiplexer); pr create's lines are the strings in internal/core/pr.
---

<Layout
  title="How Monkeypuzzle works"
  description="The whole Monkeypuzzle loop, scene by scene: cut a piece, stack it, switch between pieces, restack, submit, and merge."
>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <a class="skip-link" href="#wf">Skip to content</a>
  <header>
    <Nav />
  </header>

  <main id="wf">
    <!-- Intro -->
    <section class="wf-intro">
      <div class="wf-intro__inner wf-fade" data-reveal>
        <div class="section__eyebrow">the workflow</div>
        <h1>From one idea to a <span class="g">merged stack.</span></h1>
        <p>
          People keep asking what Monkeypuzzle actually <em>does</em>. So here's the
          whole loop, one piece at a time, from the first branch to the cleanup
          after the merge. Scroll, and watch it play out.
        </p>
        <div class="wf-scrollcue">follow along</div>
      </div>
    </section>

    <!-- 1 · Cut a piece -->
    <Scene n="1" eyebrow="cut a piece" title="Start one small idea." id="cut">
      <p>
        Every unit of work is a <strong>piece</strong>: a branch in its own git
        worktree. Cut one and Monkeypuzzle creates the branch and the worktree,
        then runs your create hook inside it.
      </p>
      <ul class="wf-points">
        <li><code>mp create --name auth-schema</code>, or leave the name off and get one generated.</li>
        <li><code>on-piece-create.sh</code> can install dependencies or copy your <code>.env</code>.</li>
        <li>Your other work never moves: no stashing, no dirty tree.</li>
      </ul>
      <WorkflowTerminal
        slot="visual"
        title="acme — zsh"
        prompt="~/acme"
        lines={[
          { cmd: 'create --name auth-schema' },
          { out: '✓ Created piece: auth-schema at ~/acme/.monkeypuzzle/pieces/auth-schema', tone: 'ok' },
          { out: '~/acme/.monkeypuzzle/pieces/auth-schema', tone: 'muted' },
          { out: '→ next: mp pr create --draft', tone: 'muted' },
        ]}
      />
    </Scene>

    <!-- 2 · Stack -->
    <Scene n="2" eyebrow="stack it" title="Build features in layers." flip>
      <p>
        Real features are more than one idea. Stack the next piece <strong>on top of</strong>
        the last with <code>mp stack append</code>: schema, then API, then UI, each a
        clean, reviewable layer built on the one below.
      </p>
      <p><code>mp stack status</code> draws the whole tree, so you always know what sits on what.</p>
      <Card slot="visual" pad class="wf-stack-anim">
        <PieceStack
          base="main"
          pieces={[
            { name: 'auth-ui', meta: '+62 −4', status: 'draft', current: true },
            { name: 'auth-api', meta: '+210 −18', status: 'draft' },
            { name: 'auth-schema', meta: '+88 −2', status: 'draft' },
          ]}
        />
      </Card>
    </Scene>

    <!-- 3 · Switch -->
    <Scene n="3" eyebrow="switch" title="Switch without losing your place." id="switch">
      <p>
        Every piece stays checked out, so moving between them is a <code>cd</code>.
        <code>mp switch</code> takes a piece or branch name and prints its worktree;
        <code>mp open</code> hands the worktree to your editor or a new terminal.
      </p>
      <ul class="wf-points">
        <li>Add <code>eval "$(mp shell-init zsh)"</code> to your shell config and your shell follows <code>mp switch</code>, <code>mp create</code> and <code>mp done</code>.</li>
        <li>No wrapper? <code>cd "$(mp switch auth-api)"</code> works anywhere.</li>
        <li>Set <code>open_command</code> once, e.g. <code>code {'{path}'}</code> or <code>zed {'{path}'}</code>, and <code>mp open</code> uses it.</li>
        <li>Live in tmux or herdr? <a href="/docs/integrations/">Give each piece a session</a>.</li>
      </ul>
      <WorkflowTerminal
        slot="visual"
        title="acme — zsh"
        prompt="~/acme"
        lines={[
          { cmd: 'switch auth-api' },
          { out: '~/acme/.monkeypuzzle/pieces/auth-api', tone: 'muted' },
          { cmd: 'open auth-ui --with code' },
        ]}
      />
    </Scene>

    <!-- 4 · Restack -->
    <Scene n="4" eyebrow="restack" title="Change one piece, fix the whole tree." flip>
      <p>
        Edit a piece low in the stack and everything above it is now stale.
        <code>mp stack sync</code> merges each parent down into its children, in
        order, and <strong>stops cleanly</strong> the moment a conflict needs you.
      </p>
      <ul class="wf-points">
        <li>It previews the sync first and asks before it changes anything.</li>
        <li>On a conflict, resolve it in the named worktree, commit, and run <code>mp stack sync</code> again.</li>
        <li>Prefer rebase? <code>--strategy rebase</code>, then <code>mp stack continue</code> after a conflict.</li>
        <li><code>mp stack undo</code> restores every branch to the pre-sync snapshot.</li>
      </ul>
      <WorkflowTerminal
        slot="visual"
        title="acme/auth-schema"
        prompt="~/acme"
        lines={[
          { cmd: 'stack sync --from origin/main --yes' },
          { out: '[dry-run] Would sync "auth-schema" (merge "main" into "auth-schema")', tone: 'muted' },
          { out: '[dry-run] Would sync "auth-api" (merge "auth-schema" into "auth-api")', tone: 'muted' },
          { out: '[dry-run] Would sync "auth-ui" (merge "auth-api" into "auth-ui")', tone: 'muted' },
          { out: '✗ Stack sync stopped: merging auth-api into "auth-ui" hit conflicts. Open ~/acme/.monkeypuzzle/pieces/auth-ui, resolve the conflicts, run \'git commit\', then run \'mp stack sync\' again. Nothing else in the stack was changed.', tone: 'err' },
        ]}
      />
    </Scene>

    <!-- 5 · Submit -->
    <Scene n="5" eyebrow="submit" title="One idea per pull request." id="submit">
      <p>
        Ship the stack. <code>mp pr create</code> pushes the piece and opens a PR
        <strong>based on the piece below it</strong>, so each PR is a single idea and
        reviewers never wade through the whole feature at once.
      </p>
      <ul class="wf-points">
        <li>The base is the piece's parent, picked for you. <code>--base</code> overrides it.</li>
        <li><code>--draft</code> opens it as a draft; <code>mp pr ready</code> flips it when it's time for eyes.</li>
        <li><code>before-pr-create.sh</code> runs first: lint, test, or write the PR body.</li>
      </ul>
      <WorkflowTerminal
        slot="visual"
        title="acme/auth-ui"
        prompt="~/acme"
        lines={[
          { cmd: 'pr create --draft' },
          { out: 'Pushing branch auth-ui to origin...', tone: 'muted' },
          { out: 'Creating PR...', tone: 'muted' },
          { out: '✓ Created PR #483: https://github.com/you/acme/pull/483', tone: 'ok' },
          { out: "→ next: mp pr ready (when it's ready for review)", tone: 'muted' },
        ]}
      />
    </Scene>

    <!-- 6 · Merge -->
    <Scene n="6" eyebrow="merge down" title="Land it, clean up after." flip id="merge">
      <p>
        When the bottom piece is approved, <code>mp merge</code> squash-merges it into
        main and re-homes the pieces above it onto main. <code>mp done</code> then
        removes the finished piece's worktree, and with shell-init your shell lands
        back in the main checkout.
      </p>
      <ul class="wf-points">
        <li>Refuses to merge when main has moved on. Run <code>mp update</code> first; no surprise overwrites.</li>
        <li>Merged on GitHub or GitLab instead? <code>mp done</code> cleans up the same way.</li>
      </ul>
      <WorkflowTerminal
        slot="visual"
        title="acme/auth-schema"
        prompt="~/acme"
        lines={[
          { cmd: 'merge --reparent-children' },
          { out: 'Re-homed auth-api onto main (force-push it if it has an open PR)', tone: 'muted' },
          { out: '✓ Squash merged auth-schema into main', tone: 'ok' },
          { out: '→ next: mp done', tone: 'muted' },
          { cmd: 'done' },
          { out: '✓ Done with piece: auth-schema', tone: 'ok' },
        ]}
      />
    </Scene>

    <!-- Closing -->
    <section class="section wf-end">
      <div class="site">
        <div class="band wf-fade" data-reveal>
          <Badge tone="green" dot>that's the loop</Badge>
          <h2 style="margin-top:16px">Cut. Stack. Restack. Submit. Merge.</h2>
          <p>Each step is one command, and each one runs your hooks.</p>
          <div class="band__actions">
            <Button size="lg" variant="accent" href="/#get-started" iconTrailing="ArrowRight">Get started</Button>
            <Button size="lg" variant="secondary" href="/docs/">Read the docs</Button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  function typeInto(el: Element, text: string): Promise<void> {
    return new Promise((resolve) => {
      el.textContent = '';
      let i = 0;
      const step = () => {
        el.textContent = text.slice(0, ++i);
        if (i >= text.length) resolve();
        else setTimeout(step, 24 + Math.random() * 26);
      };
      step();
    });
  }

  function fill(term: Element) {
    term.querySelectorAll('.wf-line').forEach((l) => l.classList.add('show'));
    term.classList.add('wf-term--done');
  }

  async function play(term: Element) {
    const lines = [...term.querySelectorAll<HTMLElement>('.wf-line:not(.wf-rest)')];
    for (const line of lines) {
      if (line.dataset.kind === 'cmd') {
        const target = line.querySelector('.mp-term__cmd');
        if (target) target.textContent = '';
        line.classList.add('show', 'wf-line--active');
        if (target) await typeInto(target, line.dataset.text || '');
        await sleep(220);
        line.classList.remove('wf-line--active');
      } else {
        line.classList.add('show');
        await sleep(120);
      }
    }
    term.classList.add('wf-term--done');
  }

  if (reduce) {
    document.querySelectorAll('[data-reveal]').forEach((e) => e.classList.add('in-view'));
    document.querySelectorAll('[data-term-anim]').forEach(fill);
  } else {
    const revealIO = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('in-view');
            revealIO.unobserve(e.target);
          }
        }
      },
      { threshold: 0.2, rootMargin: '0px 0px -8% 0px' },
    );
    document.querySelectorAll('[data-reveal]').forEach((el) => revealIO.observe(el));

    const termIO = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            termIO.unobserve(e.target);
            play(e.target);
          }
        }
      },
      { threshold: 0.4 },
    );
    document.querySelectorAll('[data-term-anim]').forEach((t) => termIO.observe(t));
  }
</script>
