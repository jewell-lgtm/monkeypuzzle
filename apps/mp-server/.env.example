# Copy to .env and fill in. (.env is gitignored.)

# Public base URL — used as the OAuth redirect base and the MCP Resource Indicator.
PUBLIC_BASE_URL=http://localhost:8080

# WorkOS (https://dashboard.workos.com). Dashboard setup:
#  - AuthKit + a GitHub OAuth connection, with "Return GitHub OAuth tokens" ON
#    (so the server gets the user's GitHub token to read repos/PRs).
#  - A Resource Indicator matching PUBLIC_BASE_URL, and Client ID Metadata
#    Document / Dynamic Client Registration enabled for MCP clients.
WORKOS_API_KEY=sk_example_replace_me
WORKOS_CLIENT_ID=client_example_replace_me
AUTHKIT_DOMAIN=https://your-app.authkit.app

# Secrets — generate each with: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME_base64_at_least_16_bytes
TOKEN_ENCRYPTION_KEY=CHANGE_ME_base64_exactly_32_bytes

# Set true when served over HTTPS.
SECURE_COOKIES=false

# For local (non-Docker) runs; docker-compose overrides these for the container network.
DATABASE_URL=postgres://mp:mp@localhost:5432/mp?sslmode=disable
TEMPORAL_HOSTPORT=localhost:7233
PORT=8080
